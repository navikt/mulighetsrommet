    "@tiltaksadministrasjon/api-client": "workspace:*",
    "@unhead/react": "3.4.3",
    "dequal": "2.0.3",
    "highcharts": "13.1.1",
    "jotai": "3.0.1",
    "jotai-family": "1.1.0",
    "react": "19.2.8",
