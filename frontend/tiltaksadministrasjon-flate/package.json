{
  "name": "@tiltaksadministrasjon/flate",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env VITE_MULIGHETSROMMET_API_MOCK=true vite",
    "backend": "../../scripts/run-backend-with-mock-token.sh -- cross-env VITE_MULIGHETSROMMET_API_BASE='http://localhost:8080' vite",
